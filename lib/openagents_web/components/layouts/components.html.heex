<% patchable? = @active_component != :icons %>
<div class="docs-layout">
  <aside class="docs-sidebar">
    <nav class="flex flex-col gap-1" aria-label="Components back">
      <div class="sidebar-row">
        <.link navigate={~p"/"} class="sidebar-row__hit" aria-label="Back to app"></.link>
        <span class="sidebar-row__content">
          <span class="sidebar-row__icon"><.icon name="arrow-left" /></span>
          <span class="sidebar-row__label">Back to app</span>
        </span>
      </div>
    </nav>

    <nav class="docs-sidebar__nav" aria-label="Component library">
      <section class="docs-sidebar__section">
        <h3 class="sidebar-section-label">Overview</h3>
        <Layouts.sidebar_link
          path={~p"/components"}
          label="All components"
          icon="book"
          selected={@active_component == :index}
          patchable={patchable?}
        />
      </section>

      <section
        :for={section <- OpenAgentsWeb.ComponentCatalog.sections()}
        class="docs-sidebar__section"
      >
        <h3 class="sidebar-section-label">{section.title}</h3>
        <Layouts.sidebar_link
          :for={item <- section.items}
          path={~p"/components/#{item.slug}"}
          label={item.title}
          icon={item.icon}
          selected={@active_component == item.slug}
          patchable={patchable?}
        />
      </section>

      <section class="docs-sidebar__section">
        <h3 class="sidebar-section-label">Reference</h3>
        <Layouts.sidebar_link
          path={~p"/components/icons"}
          label="Icons"
          icon="book-open"
          selected={@active_component == :icons}
          patchable={false}
        />
      </section>
    </nav>
  </aside>

  <div class="docs-column">
    <%!-- The header spans the content column, not the sidebar: the trail names
    where you are within the library, and the controls act on the page you are
    reading. Same arrangement as the docs surface it is modelled on. --%>
    <header class="docs-header">
      <UI.breadcrumb label="Component library">
        <:item navigate={~p"/components"}>Components</:item>
        <:item :if={assigns[:section_title]}>{@section_title}</:item>
        <:item :if={assigns[:item]}>{@item.title}</:item>
      </UI.breadcrumb>

      <div class="docs-header__controls">
        <Layouts.theme_toggle />
        <UI.copy_button
          :if={assigns[:item]}
          id="copy-component-source"
          text={@item.source}
          label="Copy source"
          copied_label="Copied"
        />
      </div>
    </header>

    <main class="docs-main">
      <.flash_group flash={@flash} />
      {@inner_content}
    </main>
  </div>
</div>
