<% patchable? = @active_component != :icons %>
<div class="docs-layout">
  <aside class="docs-sidebar">
    <Layouts.sidebar_brand title="Components" path={~p"/components"} />

    <nav class="docs-sidebar__nav" aria-label="Component library">
      <Layouts.sidebar_section
        :for={section <- OpenAgentsWeb.ComponentCatalog.sections()}
        title={section.title}
        open={Enum.any?(section.items, &(&1.slug == @active_component))}
      >
        <Layouts.sidebar_link
          :for={item <- section.items}
          path={~p"/components/#{item.slug}"}
          label={item.title}
          icon={item.icon}
          selected={@active_component == item.slug}
          patchable={patchable?}
        />
      </Layouts.sidebar_section>

      <Layouts.sidebar_section title="Reference" open={@active_component == :icons}>
        <Layouts.sidebar_link
          path={~p"/components/icons"}
          label="Icons"
          icon="book-open"
          selected={@active_component == :icons}
          patchable={false}
        />
      </Layouts.sidebar_section>
    </nav>
  </aside>

  <div class="docs-column">
    <%!-- The header spans the content column, not the sidebar: the trail names
    where you are within the library, and the controls act on the page you are
    reading. Same arrangement as the docs surface it is modelled on. --%>
    <header class="docs-header">
      <UI.breadcrumb label="Component library">
        <:item navigate={~p"/components"}>Components</:item>
        <:item :if={assigns[:section_title]}>{@section_title}</:item>
        <:item :if={assigns[:item]}>{@item.title}</:item>
      </UI.breadcrumb>

      <div class="docs-header__controls">
        <Layouts.theme_toggle />
        <UI.copy_button
          :if={assigns[:item]}
          id="copy-component-source"
          text={@item.source}
          label="Copy source"
          copied_label="Copied"
        />
      </div>
    </header>

    <main class="docs-main">
      <.flash_group flash={@flash} />
      {@inner_content}
    </main>
  </div>
</div>
