<div class="docs-layout">
  <aside class="docs-sidebar">
    <div class="docs-sidebar__header">
      <.link navigate={~p"/"} class="btn btn-ghost btn-sm gap-2">
        <.icon name="hero-arrow-left" class="w-4 h-4" /> Back to app
      </.link>
    </div>

    <div class="docs-sidebar__search">
      <.icon name="hero-magnifying-glass" class="w-4 h-4 text-base-content/50" />
      <input
        type="text"
        placeholder="Search docs..."
        class="input input-ghost input-sm w-full h-auto px-0 border-0 focus:outline-none"
      />
    </div>

    <nav class="docs-sidebar__nav" aria-label="Documentation">
      <section class="docs-sidebar__section">
        <h3 class="docs-sidebar__section-title">Get started</h3>
        <a href="#" class="docs-sidebar__link">Welcome</a>
        <a href="#" class="docs-sidebar__link">Quickstart</a>
        <a href="#" class="docs-sidebar__link">Installation</a>
      </section>
      <section class="docs-sidebar__section">
        <h3 class="docs-sidebar__section-title">Guides</h3>
        <a href="#" class="docs-sidebar__link">Authentication</a>
        <a href="#" class="docs-sidebar__link">Agents</a>
        <a href="#" class="docs-sidebar__link">Forge</a>
      </section>
      <section class="docs-sidebar__section">
        <h3 class="docs-sidebar__section-title">Reference</h3>
        <a href="#" class="docs-sidebar__link">API</a>
        <a href="#" class="docs-sidebar__link">CLI</a>
        <a href="#" class="docs-sidebar__link">Config</a>
      </section>
    </nav>
  </aside>

  <main class="docs-main">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
